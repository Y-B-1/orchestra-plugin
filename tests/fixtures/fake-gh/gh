#!/usr/bin/env python3
"""A stand-in for the gh CLI. It answers `pr list` and `pr view` from the JSON file named by FAKE_GH_DATA and appends
every call's arguments, one JSON line each, to the file named by FAKE_GH_LOG.

Data file: {"prs": [{"number", "state", "baseRefName", "headRefName", "headRefOid", ...}],
            "list_exit": 0, "list_sleep": 0, "view_exit": 0}
"""
import json
import os
import re
import sys
import time

args = sys.argv[1:]
log = os.environ.get('FAKE_GH_LOG')
if log:
    with open(log, 'a') as handle:
        handle.write(json.dumps(args) + '\n')
with open(os.environ['FAKE_GH_DATA']) as handle:
    data = json.load(handle)
prs = data.get('prs', [])
if args[:2] == ['pr', 'list']:
    time.sleep(data.get('list_sleep', 0))
    if data.get('list_exit', 0):
        sys.stderr.write('fake gh: pr list failed\n')
        sys.exit(data['list_exit'])
    print(json.dumps(prs))
elif args[:2] == ['pr', 'view'] and len(args) > 2:
    found = re.search(r'(\d+)/?$', args[2])
    pr = next((p for p in prs if found and p['number'] == int(found.group(1))), None)
    if data.get('view_exit', 0) or pr is None:
        sys.stderr.write('fake gh: pr view failed\n')
        sys.exit(data.get('view_exit') or 1)
    print(json.dumps(dict(isCrossRepository=False, **pr)))
else:
    sys.stderr.write('fake gh: unsupported call\n')
    sys.exit(2)
