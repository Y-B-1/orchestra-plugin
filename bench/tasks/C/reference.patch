@@ -0,0 +1,150 @@
+import { useState } from "react";
+import { Link } from "react-router-dom";
+import { fetchInstrumentStats, fetchInstruments, fetchPriceHistory } from "../api";
+import { AsyncContent } from "../components/AsyncContent";
+import { Drawer } from "../components/Drawer";
+import { EmptyState } from "../components/Feedback";
+import { KeyStats } from "../components/instrument/KeyStats";
+import { WatchButton } from "../components/instrument/WatchButton";
+import { PriceChange } from "../components/PriceChange";
+import { Sparkline } from "../components/Sparkline";
+import { Table, type Column } from "../components/Table";
+import { useAsync } from "../hooks/useAsync";
+import { useDocumentTitle } from "../hooks/useDocumentTitle";
+import { useWatchlist } from "../hooks/useWatchlist";
+import type { Instrument } from "../types";
+import { formatPrice } from "../utils/format";
+import { toneOf } from "../utils/numbers";
+
+function Trend({ symbol }: { symbol: string }) {
+  const state = useAsync(() => fetchPriceHistory(symbol, "1M"), [symbol]);
+  if (!state.data) return null;
+  const closes = state.data.map((point) => point.close);
+  const first = closes[0] ?? 0;
+  const last = closes[closes.length - 1] ?? 0;
+  return <Sparkline values={closes} label={`${symbol} 1 month trend`} width={120} height={32} tone={toneOf(last - first)} showArea={false} />;
+}
+
+function Details({ instrument, onClose }: { instrument: Instrument; onClose: () => void }) {
+  const stats = useAsync(() => fetchInstrumentStats(instrument.symbol), [instrument.symbol]);
+  return (
+    <Drawer label="Instrument details" title={instrument.name} subtitle={instrument.symbol} onClose={onClose} closeLabel="Close instrument details">
+      <p className="watch-details__actions">
+        <WatchButton symbol={instrument.symbol} />
+        <Link to={`/instruments/${instrument.symbol}`}>Open instrument page</Link>
+      </p>
+      <AsyncContent state={stats} loadingLabel="Loading key stats">
+        {(data) => <KeyStats instrument={instrument} stats={data} />}
+      </AsyncContent>
+    </Drawer>
+  );
+}
+
+function WatchlistView({ instruments }: { instruments: Instrument[] }) {
+  const { symbols, toggle } = useWatchlist();
+  const [openSymbol, setOpenSymbol] = useState<string | null>(null);
+  const rows = symbols
+    .map((symbol) => instruments.find((instrument) => instrument.symbol === symbol))
+    .filter((instrument): instrument is Instrument => instrument !== undefined);
+  const available = instruments.filter((instrument) => !symbols.includes(instrument.symbol));
+  const [choice, setChoice] = useState("");
+  const selected = available.some((i) => i.symbol === choice) ? choice : (available[0]?.symbol ?? "");
+  const open = rows.find((row) => row.symbol === openSymbol) ?? instruments.find((i) => i.symbol === openSymbol);
+
+  const columns: Column<Instrument>[] = [
+    {
+      key: "symbol",
+      header: "Instrument",
+      rowHeader: true,
+      render: (row) => (
+        <>
+          <span className="table__symbol">{row.symbol}</span>
+          <span className="table__name">{row.name}</span>
+        </>
+      ),
+    },
+    { key: "price", header: "Last price", align: "right", render: (row) => formatPrice(row.price, row.currency) },
+    { key: "change", header: "Day change", align: "right", render: (row) => <PriceChange pct={row.changePct} /> },
+    { key: "trend", header: "1 month trend", render: (row) => <Trend symbol={row.symbol} /> },
+    {
+      key: "remove",
+      header: "",
+      render: (row) => (
+        <button
+          type="button"
+          className="button button--small button--ghost"
+          aria-label={`Remove ${row.symbol}`}
+          onClick={(event) => {
+            event.stopPropagation();
+            toggle(row.symbol);
+          }}
+        >
+          Remove
+        </button>
+      ),
+    },
+  ];
+
+  return (
+    <>
+      {available.length > 0 ? (
+        <form
+          className="filters"
+          onSubmit={(event) => {
+            event.preventDefault();
+            if (selected) toggle(selected);
+          }}
+        >
+          <div className="filters__field">
+            <label className="filters__label" htmlFor="watchlist-add">
+              Add instrument
+            </label>
+            <select id="watchlist-add" className="input input--compact" value={selected} onChange={(e) => setChoice(e.target.value)}>
+              {available.map((instrument) => (
+                <option key={instrument.symbol} value={instrument.symbol}>
+                  {instrument.symbol} {instrument.name}
+                </option>
+              ))}
+            </select>
+          </div>
+          <div className="filters__actions">
+            <button type="submit" className="button button--primary">
+              Add
+            </button>
+          </div>
+        </form>
+      ) : null}
+      {rows.length === 0 ? (
+        <EmptyState message="Your watchlist is empty." />
+      ) : (
+        <Table
+          caption="Watched instruments"
+          columns={columns}
+          rows={rows}
+          rowKey={(row) => row.symbol}
+          onRowClick={(row) => setOpenSymbol(row.symbol)}
+          selectedKey={openSymbol}
+        />
+      )}
+      {open ? <Details instrument={open} onClose={() => setOpenSymbol(null)} /> : null}
+    </>
+  );
+}
+
+/** Every followed instrument with its price, day change and a 1 month trend; rows open details. */
+export function WatchlistPage() {
+  useDocumentTitle("Watchlist");
+  const instruments = useAsync(() => fetchInstruments(), []);
+  return (
+    <div className="page">
+      <section className="panel" aria-label="Watchlist">
+        <div className="panel__header">
+          <h2 className="panel__title">Watchlist</h2>
+        </div>
+        <AsyncContent state={instruments} loadingLabel="Loading watchlist">
+          {(list) => <WatchlistView instruments={list} />}
+        </AsyncContent>
+      </section>
+    </div>
+  );
+}
