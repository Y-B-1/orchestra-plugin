@@ -0,0 +1,130 @@
+import { useId, useState, type FormEvent } from "react";
+import { fetchInstruments } from "../api";
+import { AsyncContent } from "../components/AsyncContent";
+import { EmptyState } from "../components/Feedback";
+import { useAlerts } from "../hooks/useAlerts";
+import { useAsync } from "../hooks/useAsync";
+import { useDocumentTitle } from "../hooks/useDocumentTitle";
+import type { AlertCondition, Instrument } from "../types";
+import { describeAlert, isTriggered } from "../utils/alerts";
+
+function AlertForm({ instruments }: { instruments: Instrument[] }) {
+  const id = useId();
+  const { add } = useAlerts();
+  const [symbol, setSymbol] = useState(instruments[0]?.symbol ?? "");
+  const [condition, setCondition] = useState<AlertCondition>("above");
+  const [price, setPrice] = useState("");
+  const [error, setError] = useState<string | null>(null);
+
+  function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const value = Number(price);
+    if (price.trim() === "" || !Number.isFinite(value) || value <= 0) {
+      setError("Enter a price above zero");
+      return;
+    }
+    add(symbol, condition, value);
+    setError(null);
+    setPrice("");
+  }
+
+  return (
+    <form className="filters" onSubmit={submit} aria-label="New alert">
+      <div className="filters__field">
+        <label className="filters__label" htmlFor={`${id}-symbol`}>
+          Instrument
+        </label>
+        <select id={`${id}-symbol`} className="input input--compact" value={symbol} onChange={(e) => setSymbol(e.target.value)}>
+          {instruments.map((instrument) => (
+            <option key={instrument.symbol} value={instrument.symbol}>
+              {instrument.symbol} {instrument.name}
+            </option>
+          ))}
+        </select>
+      </div>
+      <div className="filters__field">
+        <label className="filters__label" htmlFor={`${id}-condition`}>
+          Condition
+        </label>
+        <select
+          id={`${id}-condition`}
+          className="input input--compact"
+          value={condition}
+          onChange={(e) => setCondition(e.target.value as AlertCondition)}
+        >
+          <option value="above">goes above</option>
+          <option value="below">goes below</option>
+        </select>
+      </div>
+      <div className="filters__field">
+        <label className="filters__label" htmlFor={`${id}-price`}>
+          Price
+        </label>
+        <input
+          id={`${id}-price`}
+          type="number"
+          min={0}
+          step="any"
+          className="input input--compact"
+          value={price}
+          onChange={(e) => setPrice(e.target.value)}
+        />
+      </div>
+      <div className="filters__actions">
+        <button type="submit" className="button button--primary">
+          Add alert
+        </button>
+      </div>
+      {error ? (
+        <p className="filters__error" role="alert">
+          {error}
+        </p>
+      ) : null}
+    </form>
+  );
+}
+
+function AlertList({ instruments }: { instruments: Instrument[] }) {
+  const { alerts, remove } = useAlerts();
+  if (alerts.length === 0) return <EmptyState message="No alerts yet." />;
+  return (
+    <ul className="alert-list">
+      {alerts.map((alert) => {
+        const instrument = instruments.find((i) => i.symbol === alert.symbol);
+        const text = describeAlert(alert, instrument?.currency);
+        const triggered = instrument ? isTriggered(alert, instrument.price) : false;
+        return (
+          <li key={alert.id} className="alert-list__item">
+            <span className="alert-list__text">{text}</span>
+            <span className={`badge ${triggered ? "badge--triggered" : "badge--watching"}`}>{triggered ? "Triggered" : "Watching"}</span>
+            <button type="button" className="button button--small button--ghost" onClick={() => remove(alert.id)} aria-label={`Remove ${text}`}>
+              Remove
+            </button>
+          </li>
+        );
+      })}
+    </ul>
+  );
+}
+
+export function Alerts() {
+  useDocumentTitle("Alerts");
+  const instruments = useAsync(() => fetchInstruments(), []);
+  return (
+    <div className="page">
+      <section className="panel" aria-label="Price alerts">
+        <div className="panel__header">
+          <h2 className="panel__title">Price alerts</h2>
+        </div>
+        <AsyncContent state={instruments} loadingLabel="Loading instruments">
+          {(list) => (
+            <>
+              <AlertForm instruments={list} />
+              <AlertList instruments={list} />
+            </>
+          )}
+        </AsyncContent>
+      </section>
+    </div>
+  );
+}
