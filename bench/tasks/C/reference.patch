+import { describe, expect, it } from "vitest";
+import type { Instrument, PriceAlert } from "../types";
+import { alertNotifications, describeAlert, isTriggered } from "./alerts";
+
+const aapl: Instrument = { symbol: "AAPL", name: "Apple Inc.", assetClass: "equity", price: 227.48, changePct: 0, volume: 1, currency: "USD" };
+const above: PriceAlert = { id: "a1", symbol: "AAPL", condition: "above", price: 200, createdAt: "2026-10-27T10:00:00Z" };
+
+describe("price alerts", () => {
+  it("knows when an alert is already past its level", () => {
+    expect(isTriggered(above, 227.48)).toBe(true);
+    expect(isTriggered({ ...above, condition: "below" }, 227.48)).toBe(false);
+    expect(describeAlert({ ...above, symbol: "EURUSD", condition: "below", price: 1.1 })).toBe("EURUSD goes below $1.1000");
+  });
+
+  it("turns triggered alerts into notifications with stable ids", () => {
+    const notes = alertNotifications([above, { ...above, id: "a2", price: 500 }], [aapl]);
+    expect(notes).toEqual([
+      expect.objectContaining({ id: "alert-a1", kind: "alert", title: "AAPL is above $200.00", body: "Last price $227.48.", read: false }),
+    ]);
+  });
+});
diff --git a/src/utils/alerts.ts b/src/utils/alerts.ts
new file mode 100644
index 0000000..445b979
--- /dev/null
+++ b/src/utils/alerts.ts
@@ -0,0 +1,31 @@
+import type { AppNotification, Instrument, PriceAlert } from "../types";
+import { formatPrice } from "./format";
+
+/** True when the last price is already past the alert's level. */
+export function isTriggered(alert: PriceAlert, lastPrice: number): boolean {
+  return alert.condition === "above" ? lastPrice > alert.price : lastPrice < alert.price;
+}
+
+/** "AAPL goes above $250.00", priced with the instrument's usual digits. */
+export function describeAlert(alert: PriceAlert, currency = "USD"): string {
+  return `${alert.symbol} goes ${alert.condition} ${formatPrice(alert.price, currency)}`;
+}
+
+/** One unread bell notification per triggered alert; its id is stable so read state survives reloads. */
+export function alertNotifications(alerts: readonly PriceAlert[], instruments: readonly Instrument[]): AppNotification[] {
+  const out: AppNotification[] = [];
+  for (const alert of alerts) {
+    const instrument = instruments.find((i) => i.symbol === alert.symbol);
+    if (!instrument || !isTriggered(alert, instrument.price)) continue;
+    out.push({
+      id: `alert-${alert.id}`,
