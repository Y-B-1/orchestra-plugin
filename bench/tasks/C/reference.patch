diff --git a/src/hooks/useAlerts.tsx b/src/hooks/useAlerts.tsx
new file mode 100644
index 0000000..b3c2efb
--- /dev/null
+++ b/src/hooks/useAlerts.tsx
@@ -0,0 +1,45 @@
+import { createContext, useCallback, useContext, useMemo, type ReactNode } from "react";
+import type { AlertCondition, PriceAlert } from "../types";
+import { createId } from "../utils/ids";
+import { useLocalStorage } from "./useLocalStorage";
+
+export const ALERTS_KEY = "pulse.alerts";
+
+interface AlertsContextValue {
+  alerts: PriceAlert[];
+  add: (symbol: string, condition: AlertCondition, price: number) => void;
+  remove: (id: string) => void;
+}
+
+const AlertsContext = createContext<AlertsContextValue | null>(null);
+
+/** Price alerts the user has set, kept in this browser. */
+export function AlertsProvider({ children }: { children: ReactNode }) {
+  const [alerts, setAlerts] = useLocalStorage<PriceAlert[]>(ALERTS_KEY, []);
+
+  const add = useCallback(
+    (symbol: string, condition: AlertCondition, price: number) => {
+      const alert: PriceAlert = { id: createId("alert"), symbol, condition, price, createdAt: new Date().toISOString() };
+      setAlerts((prev) => [alert, ...prev]);
+    },
+    [setAlerts],
+  );
+
+  const remove = useCallback((id: string) => setAlerts((prev) => prev.filter((alert) => alert.id !== id)), [setAlerts]);
+
+  const value = useMemo(() => ({ alerts, add, remove }), [alerts, add, remove]);
+  return <AlertsContext.Provider value={value}>{children}</AlertsContext.Provider>;
+}
+
+export function useAlerts(): AlertsContextValue {
+  const ctx = useContext(AlertsContext);
+  if (!ctx) throw new Error("useAlerts must be used inside AlertsProvider");
+  return ctx;
+}
+
+const noAlerts: PriceAlert[] = [];
+
+/** The alert list, or none outside an AlertsProvider (the bell works without alerts). */
+export function useAlertList(): PriceAlert[] {
+  return useContext(AlertsContext)?.alerts ?? noAlerts;
+}
