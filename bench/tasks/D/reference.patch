@@ -0,0 +1,16 @@
+import type { Report } from "../../types";
+import { formatDate } from "../../utils/format";
+import { matchesQuery } from "../../utils/search";
+
+/** "Oct 27, 2026 · A. Moreau · 6 pages"; scheduled reports read "Due Oct 30, 2026 · L. Duarte". */
+export function reportMeta(report: Report): string {
+  const date = formatDate(report.date);
+  const parts = [report.status === "scheduled" ? `Due ${date}` : date, report.author];
+  if (report.pages > 0) parts.push(`${report.pages} ${report.pages === 1 ? "page" : "pages"}`);
+  return parts.join(" · ");
+}
+
+/** Reports whose title or author contains the query, ignoring case. */
+export function searchReports(reports: readonly Report[], query: string): Report[] {
+  return reports.filter((report) => matchesQuery(query, report.title, report.author));
+}
