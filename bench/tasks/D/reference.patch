@@ -0,0 +1,26 @@
+import type { Position } from "../../types";
+import { downloadCsv, toCsv, type CsvColumn } from "../../utils/csv";
+import { assetClassLabels } from "../../utils/portfolio";
+import type { Money } from "./money";
+
+/** CSV columns of the holdings export: raw numbers, values in the currency on screen. */
+export function holdingsCsvColumns({ currency, convert }: Money): CsvColumn<Position>[] {
+  return [
+    { header: "Instrument", value: (p) => p.symbol },
+    { header: "Name", value: (p) => p.name },
+    { header: "Asset class", value: (p) => assetClassLabels[p.assetClass] },
+    { header: "Book", value: (p) => p.book },
+    { header: "Quantity", value: (p) => p.quantity },
+    { header: "Avg cost", value: (p) => p.avgCost },
+    { header: "Price", value: (p) => p.price },
+    { header: "Price currency", value: (p) => p.currency },
+    { header: `Market value (${currency})`, value: (p) => convert(p.marketValueUsd).toFixed(2) },
+    { header: `Unrealized P&L (${currency})`, value: (p) => convert(p.unrealizedPnlUsd).toFixed(2) },
+    { header: "Weight", value: (p) => p.weight.toFixed(4) },
+  ];
+}
+
+export function exportHoldings(positions: readonly Position[], money: Money, today = new Date()): void {
+  const day = today.toISOString().slice(0, 10);
+  downloadCsv(`pulse-holdings-${day}.csv`, toCsv(positions, holdingsCsvColumns(money)));
+}
