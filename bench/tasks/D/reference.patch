+import type { FxRates } from "../../types";
+import { fromUsd, type DisplayCurrency } from "../../utils/portfolio";
+
+/** The currency the portfolio page shows its values in, and how to get there from USD. */
+export interface Money {
+  currency: DisplayCurrency;
+  convert: (amountUsd: number) => number;
+}
+
+export function moneyIn(currency: DisplayCurrency, rates: FxRates): Money {
+  return { currency, convert: (amountUsd) => fromUsd(amountUsd, currency, rates) };
+}
