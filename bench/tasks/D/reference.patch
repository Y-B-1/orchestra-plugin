@@ -0,0 +1,20 @@
+import { parseNote } from "../../utils/noteText";
+
+/** A note with its **bold** and [link](https://...) formatting; everything else is plain text. */
+export function NoteText({ text }: { text: string }) {
+  return (
+    <p className="client-notes__text">
+      {parseNote(text).map((part, index) => {
+        if (part.kind === "bold") return <strong key={index}>{part.text}</strong>;
+        if (part.kind === "link") {
+          return (
+            <a key={index} href={part.href} target="_blank" rel="noopener noreferrer">
+              {part.text}
+            </a>
+          );
+        }
+        return part.text;
+      })}
+    </p>
+  );
+}
