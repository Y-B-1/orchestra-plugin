diff --git a/src/utils/noteText.ts b/src/utils/noteText.ts
new file mode 100644
index 0000000..f1e5ca7
--- /dev/null
+++ b/src/utils/noteText.ts
@@ -0,0 +1,45 @@
+/** A piece of a client note: plain text, **bold** text, or a [label](https://...) link. */
+export type NotePart =
+  | { kind: "text"; text: string }
+  | { kind: "bold"; text: string }
+  | { kind: "link"; text: string; href: string };
+
+const TOKEN = /\*\*(.+?)\*\*|\[([^\]\n]+)\]\(([^)\s]+)\)/g;
+
+/** Only web links become links; anything else (javascript:, data:, relative) stays text. */
+export function safeHref(url: string): string | null {
+  try {
+    const parsed = new URL(url);
+    return parsed.protocol === "https:" || parsed.protocol === "http:" ? parsed.href : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Splits a note into parts. The result is rendered as React text and elements,
+ * never as HTML, so markup typed into a note shows as the characters typed.
+ */
+export function parseNote(text: string): NotePart[] {
+  const parts: NotePart[] = [];
+  let last = 0;
+  const push = (part: NotePart) => {
+    const prev = parts[parts.length - 1];
+    if (part.kind === "text" && prev?.kind === "text") prev.text += part.text;
+    else parts.push(part);
+  };
+  for (const match of text.matchAll(TOKEN)) {
+    const index = match.index ?? 0;
+    if (index > last) push({ kind: "text", text: text.slice(last, index) });
+    const [whole, bold, label, url] = match;
+    if (bold !== undefined) {
+      push({ kind: "bold", text: bold });
+    } else {
+      const href = safeHref(url ?? "");
+      push(href ? { kind: "link", text: label ?? "", href } : { kind: "text", text: whole });
+    }
+    last = index + whole.length;
+  }
+  if (last < text.length) push({ kind: "text", text: text.slice(last) });
+  return parts;
+}
