new file mode 100644
index 0000000..15ef1fb
--- /dev/null
+++ b/src/utils/settings.ts
@@ -0,0 +1,46 @@
+import type { ReportDigest, Settings } from "../types";
+
+export const defaultSettings: Settings = {
+  theme: "light",
+  emailAlerts: true,
+  pushAlerts: false,
+  reportDigest: "weekly",
+};
+
+export const reportDigests: { value: ReportDigest; label: string }[] = [
+  { value: "off", label: "Off" },
+  { value: "daily", label: "Daily" },
+  { value: "weekly", label: "Weekly" },
+];
+
+const isDigest = (value: unknown): value is ReportDigest => reportDigests.some((digest) => digest.value === value);
+
+/**
+ * Settings from whatever was saved. Older saves had a `weeklyDigest` switch:
+ * on becomes a weekly digest and off becomes no digest. Fields that are missing
+ * or of the wrong type fall back to the defaults, and so does anything that is
+ * not a settings object at all.
+ */
+export function migrateSettings(saved: unknown): Settings {
+  if (typeof saved !== "object" || saved === null || Array.isArray(saved)) return { ...defaultSettings };
+  const raw = saved as Record<string, unknown>;
+  const flag = (key: "emailAlerts" | "pushAlerts") => (typeof raw[key] === "boolean" ? raw[key] : defaultSettings[key]);
+  let reportDigest = defaultSettings.reportDigest;
+  if (isDigest(raw.reportDigest)) reportDigest = raw.reportDigest;
+  else if (typeof raw.weeklyDigest === "boolean") reportDigest = raw.weeklyDigest ? "weekly" : "off";
+  return {
+    theme: raw.theme === "dark" || raw.theme === "light" ? raw.theme : defaultSettings.theme,
+    emailAlerts: flag("emailAlerts"),
+    pushAlerts: flag("pushAlerts"),
+    reportDigest,
+  };
+}
+
+export function loadSettings(key: string): Settings {
+  try {
+    const raw = localStorage.getItem(key);
+    return raw === null ? { ...defaultSettings } : migrateSettings(JSON.parse(raw));
+  } catch {
+    return { ...defaultSettings };
+  }
+}
