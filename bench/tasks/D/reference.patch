+
+/** Book names in A to Z order. */
+export function bookNames(positions: readonly Position[]): string[] {
+  return [...new Set(positions.map((p) => p.book))].sort((a, b) => a.localeCompare(b));
+}
+
+/** Positions, market value and unrealized P&L per book, largest market value first. */
+export function pnlByBook(positions: readonly Position[]): BookPnl[] {
+  return bookNames(positions)
+    .map((book) => {
+      const rows = positions.filter((p) => p.book === book);
+      return {
+        book,
+        positions: rows.length,
+        marketValueUsd: sum(rows.map((p) => p.marketValueUsd)),
+        unrealizedPnlUsd: sum(rows.map((p) => p.unrealizedPnlUsd)),
+      };
+    })
+    .sort((a, b) => b.marketValueUsd - a.marketValueUsd);
+}
