+import { describe, expect, it } from "vitest";
+import { pinnedFirst, storedNotes } from "./storedNotes";
+
+const old = { id: "n1", text: "Older", author: "Dana Whitaker", createdAt: "2026-10-25T10:00:00Z" };
+
+describe("storedNotes", () => {
+  it("reads notes saved before pinning as unpinned", () => {
+    expect(storedNotes([old])).toEqual([{ ...old, pinned: false }]);
+  });
+
+  it("reads anything that is not a list of notes as no notes", () => {
+    expect(storedNotes({ notes: [old] })).toEqual([]);
+    expect(storedNotes("text")).toEqual([]);
+    expect(storedNotes(null)).toEqual([]);
+    expect(storedNotes([old, 5, { id: 1 }])).toHaveLength(1);
+  });
+
+  it("lists pinned notes first", () => {
+    const notes = storedNotes([{ ...old, id: "a" }, { ...old, id: "b", pinned: true }]);
+    expect(pinnedFirst(notes).map((note) => note.id)).toEqual(["b", "a"]);
+  });
+});
