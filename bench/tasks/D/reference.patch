+import { useMemo } from "react";
+import type { Position } from "../../types";
+import { formatCurrency } from "../../utils/format";
+import { formatSignedCurrency, toneOf } from "../../utils/numbers";
+import { pnlByBook, type BookPnl as Row } from "../../utils/portfolio";
+import { Table, type Column } from "../Table";
+import type { Money } from "./money";
+
+function bookColumns({ currency, convert }: Money): Column<Row>[] {
+  return [
+    { key: "book", header: "Book", rowHeader: true, render: (row) => row.book },
+    { key: "positions", header: "Positions", align: "right", render: (row) => row.positions },
+    {
+      key: "marketValue",
+      header: "Market value",
+      align: "right",
+      render: (row) => formatCurrency(convert(row.marketValueUsd), currency, { wholeUnits: true }),
+    },
+    {
+      key: "pnl",
+      header: "Unrealized P&L",
+      align: "right",
+      render: (row) => formatSignedCurrency(convert(row.unrealizedPnlUsd), currency),
+      cellClassName: (row) => `text-${toneOf(row.unrealizedPnlUsd)}`,
+    },
+  ];
+}
+
+/** Every book in the portfolio, whatever the holdings table is filtered to. */
+export function BookPnl({ positions, money }: { positions: Position[]; money: Money }) {
+  const rows = useMemo(() => pnlByBook(positions), [positions]);
+  const columns = useMemo(() => bookColumns(money), [money]);
+  return <Table caption="P&L by book" columns={columns} rows={rows} rowKey={(row) => row.book} />;
+}
