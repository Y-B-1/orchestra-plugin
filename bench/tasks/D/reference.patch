+++ b/src/components/clients/storedNotes.ts
@@ -0,0 +1,25 @@
+import type { ClientNote } from "../../types";
+
+function isNote(value: unknown): value is ClientNote {
+  if (typeof value !== "object" || value === null) return false;
+  const note = value as Record<string, unknown>;
+  return typeof note.id === "string" && typeof note.text === "string" && typeof note.createdAt === "string";
+}
+
+/**
+ * Notes as saved in the browser. Anything that is not a list of notes reads as no
+ * notes, and notes saved before pinning existed come back unpinned.
+ */
+export function storedNotes(value: unknown): ClientNote[] {
+  if (!Array.isArray(value)) return [];
+  return value.filter(isNote).map((note) => ({
+    ...note,
+    author: typeof note.author === "string" ? note.author : "",
+    pinned: note.pinned === true,
+  }));
+}
+
+/** Pinned notes first; each group keeps its saved order (newest first). */
+export function pinnedFirst(notes: readonly ClientNote[]): ClientNote[] {
+  return [...notes.filter((note) => note.pinned), ...notes.filter((note) => !note.pinned)];
+}
