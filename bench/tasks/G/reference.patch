+import { fetchVenueSummary } from "../api";
+import { AsyncContent } from "../components/AsyncContent";
+import { Table, type Column } from "../components/Table";
+import { useAsync } from "../hooks/useAsync";
+import { useDocumentTitle } from "../hooks/useDocumentTitle";
+import type { VenueSummary } from "../utils/venues";
+
+const columns: Column<VenueSummary>[] = [
+  { key: "venue", header: "Venue", rowHeader: true, render: (row) => row.venue, sortValue: (row) => row.venue },
+  { key: "trades", header: "Trades", align: "right", render: (row) => row.trades, sortValue: (row) => row.trades },
+  { key: "filled", header: "Filled", align: "right", render: (row) => row.filled, sortValue: (row) => row.filled },
+  { key: "partial", header: "Partially filled", align: "right", render: (row) => row.partial, sortValue: (row) => row.partial },
+  { key: "cancelled", header: "Cancelled", align: "right", render: (row) => row.cancelled, sortValue: (row) => row.cancelled },
+];
+
+export function Venues() {
+  useDocumentTitle("Venues");
+  const state = useAsync(fetchVenueSummary, []);
+  return (
+    <div className="page">
+      <section className="panel" aria-label="Venues">
+        <div className="panel__header">
+          <h2 className="panel__title">Venue summary</h2>
+        </div>
+        <AsyncContent state={state} loadingLabel="Loading venues">
+          {(rows) => (
+            <Table
+              caption="Venue summary"
+              columns={columns}
+              rows={rows}
+              rowKey={(row) => row.venue}
+              initialSort={{ key: "trades", direction: "desc" }}
+              emptyMessage="No venues yet."
+            />
+          )}
+        </AsyncContent>
+      </section>
+    </div>
+  );
+}
