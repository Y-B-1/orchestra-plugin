index 0000000..5bef119
--- /dev/null
+++ b/src/utils/venues.ts
@@ -0,0 +1,21 @@
+import type { Trade } from "../types";
+
+export interface VenueSummary {
+  venue: string;
+  trades: number;
+  filled: number;
+  partial: number;
+  cancelled: number;
+}
+
+/** One row per venue with how many trades it took and how many ended in each status. */
+export function summarizeVenues(trades: readonly Trade[]): VenueSummary[] {
+  const byVenue = new Map<string, VenueSummary>();
+  for (const trade of trades) {
+    const row = byVenue.get(trade.venue) ?? { venue: trade.venue, trades: 0, filled: 0, partial: 0, cancelled: 0 };
+    row.trades += 1;
+    row[trade.status] += 1;
+    byVenue.set(trade.venue, row);
+  }
+  return [...byVenue.values()];
+}
