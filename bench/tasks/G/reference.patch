+
+beforeEach(() => {
+  latency.ms = 0;
+  localStorage.clear();
+});
+
+describe("authenticate", () => {
+  it("accepts the right password and flags non-admins for a change", async () => {
+    expect((await authenticate("dana@pulse.test", "Harbor-4471")).mustChangePassword).toBe(false);
+    expect((await authenticate("marc@pulse.test", "Quartz-2208")).mustChangePassword).toBe(true);
+  });
+
+  it("rejects the shared demo password and other people's passwords with one error", async () => {
+    await expect(authenticate("dana@pulse.test", "demo")).rejects.toBeInstanceOf(AuthError);
+    await expect(authenticate("dana@pulse.test", "Quartz-2208")).rejects.toThrow("Wrong email or password.");
+    await expect(authenticate("nobody@pulse.test", "Harbor-4471")).rejects.toThrow("Wrong email or password.");
