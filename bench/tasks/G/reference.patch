+++ b/src/hooks/useAuth.tsx
@@ -0,0 +1,78 @@
+import { createContext, useCallback, useContext, useMemo, useState, type ReactNode } from "react";
+import { authenticate, findUser, savePassword } from "../api";
+import type { User } from "../types";
+
+export const SESSION_KEY = "pulse.session";
+
+interface AuthContextValue {
+  /** The signed-in user, or null. */
+  user: User | null;
+  /** Someone who signed in correctly but has to choose a new password before anything else. */
+  pending: User | null;
+  signIn: (email: string, password: string) => Promise<void>;
+  changePassword: (password: string) => Promise<void>;
+  signOut: () => void;
+}
+
+const AuthContext = createContext<AuthContextValue | null>(null);
+
+function loadSession(): User | null {
+  try {
+    const raw = localStorage.getItem(SESSION_KEY);
+    const email: unknown = raw === null ? null : JSON.parse(raw);
+    return typeof email === "string" ? (findUser(email) ?? null) : null;
+  } catch {
+    return null;
+  }
+}
+
+function storeSession(user: User | null): void {
+  try {
+    if (user) localStorage.setItem(SESSION_KEY, JSON.stringify(user.email));
+    else localStorage.removeItem(SESSION_KEY);
+  } catch {
+    // Storage can be blocked; the session then lasts until the page reloads.
+  }
+}
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [user, setUser] = useState<User | null>(loadSession);
+  const [pending, setPending] = useState<User | null>(null);
+
+  const open = useCallback((next: User) => {
+    storeSession(next);
+    setPending(null);
+    setUser(next);
+  }, []);
+
+  const value = useMemo<AuthContextValue>(
+    () => ({
+      user,
+      pending,
+      signIn: async (email, password) => {
+        const result = await authenticate(email, password);
+        if (result.mustChangePassword) setPending(result.user);
+        else open(result.user);
+      },
+      changePassword: async (password) => {
+        if (!pending) return;
+        await savePassword(pending.email, password);
+        open(pending);
+      },
+      signOut: () => {
+        storeSession(null);
+        setUser(null);
+        setPending(null);
+      },
+    }),
+    [user, pending, open],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthContextValue {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error("useAuth must be used inside AuthProvider");
+  return ctx;
+}
