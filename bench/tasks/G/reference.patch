@@ -0,0 +1,37 @@
+import type { NavbarVariant, Settings, Theme } from "../types";
+
+export const defaultSettings: Settings = {
+  theme: "light",
+  alerts: { email: true, digest: true },
+  navbar: "sidebar",
+};
+
+const themes: readonly Theme[] = ["light", "dark"];
+const navbars: readonly NavbarVariant[] = ["sidebar", "compact", "top"];
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function bool(value: unknown, fallback: boolean): boolean {
+  return typeof value === "boolean" ? value : fallback;
+}
+
+/**
+ * Turns whatever is stored into the current settings shape. The old flat shape
+ * (emailAlerts, pushAlerts, weeklyDigest) is converted; push alerts are dropped.
+ */
+export function migrateSettings(stored: unknown): Settings {
+  if (!isRecord(stored)) return defaultSettings;
+  const alerts = isRecord(stored.alerts) ? stored.alerts : {};
+  const email = "email" in alerts ? alerts.email : stored.emailAlerts;
+  const digest = "digest" in alerts ? alerts.digest : stored.weeklyDigest;
+  return {
+    theme: themes.find((t) => t === stored.theme) ?? defaultSettings.theme,
+    alerts: {
+      email: bool(email, defaultSettings.alerts.email),
+      digest: bool(digest, defaultSettings.alerts.digest),
+    },
+    navbar: navbars.find((n) => n === stored.navbar) ?? defaultSettings.navbar,
+  };
+}
