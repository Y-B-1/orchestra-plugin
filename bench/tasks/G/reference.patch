diff --git a/src/api/auth.ts b/src/api/auth.ts
new file mode 100644
index 0000000..0c27ae8
--- /dev/null
+++ b/src/api/auth.ts
@@ -0,0 +1,63 @@
+import data from "../data/users.json";
+import type { User } from "../types";
+import { delay } from "./client";
+
+interface Account extends User {
+  password: string;
+}
+
+const accounts = data as Account[];
+
+export const PASSWORDS_KEY = "pulse.passwords";
+export const SIGN_IN_ERROR = "Wrong email or password.";
+
+export class AuthError extends Error {
+  constructor() {
+    super(SIGN_IN_ERROR);
+    this.name = "AuthError";
+  }
+}
+
+export interface SignInResult {
+  user: User;
+  /** True until the person has chosen their own password; admins are exempt. */
+  mustChangePassword: boolean;
+}
+
+function toUser({ email, name, role }: Account): User {
+  return { email, name, role };
+}
+
+/** Passwords people chose themselves, kept in this browser because the mock API has no server. */
+function chosenPasswords(): Record<string, string> {
+  try {
+    const parsed: unknown = JSON.parse(localStorage.getItem(PASSWORDS_KEY) ?? "{}");
+    return typeof parsed === "object" && parsed !== null ? (parsed as Record<string, string>) : {};
+  } catch {
+    return {};
+  }
+}
+
+export function findUser(email: string): User | undefined {
+  const account = accounts.find((a) => a.email === email);
+  return account ? toUser(account) : undefined;
+}
+
+/** Checks an email and password. Every failure is the same error, and nothing ever locks an account. */
+export async function authenticate(email: string, password: string): Promise<SignInResult> {
+  const account = accounts.find((a) => a.email === email.trim().toLowerCase());
+  const chosen = account ? chosenPasswords()[account.email] : undefined;
+  const ok = account !== undefined && password === (chosen ?? account.password);
+  await delay(null);
+  if (!account || !ok) throw new AuthError();
+  return { user: toUser(account), mustChangePassword: account.role !== "admin" && chosen === undefined };
+}
+
+export async function savePassword(email: string, password: string): Promise<void> {
+  try {
+    localStorage.setItem(PASSWORDS_KEY, JSON.stringify({ ...chosenPasswords(), [email]: password }));
+  } catch {
+    // Storage can be full or blocked; the new password then lasts for this session only.
+  }
+  await delay(undefined);
+}
