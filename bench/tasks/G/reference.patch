+export const MIN_PASSWORD_LENGTH = 10;
+export const SHORT_PASSWORD_MESSAGE = "Use at least 10 characters.";
+export const MISMATCH_MESSAGE = "Passwords do not match.";
+
+/** The message to show for a new password and its confirmation, or null when both are fine. */
+export function validateNewPassword(password: string, confirmation: string): string | null {
+  if (password.length < MIN_PASSWORD_LENGTH) return SHORT_PASSWORD_MESSAGE;
+  if (password !== confirmation) return MISMATCH_MESSAGE;
+  return null;
+}
