--- /dev/null
+++ b/src/components/dashboard/NewClients.tsx
@@ -0,0 +1,24 @@
+import { fetchClients } from "../../api";
+import { useAsync } from "../../hooks/useAsync";
+import { AS_OF_DAY } from "../../utils/dates";
+import { newClientsInMonth } from "../../utils/clients";
+import { AsyncContent } from "../AsyncContent";
+
+export function NewClients() {
+  const state = useAsync(() => fetchClients(), []);
+  return (
+    <AsyncContent state={state} loadingLabel="Loading new clients">
+      {(clients) => {
+        const names = newClientsInMonth(clients, AS_OF_DAY);
+        if (names.length === 0) return <p className="feedback feedback--empty">No new clients this month.</p>;
+        return (
+          <ul className="simple-list">
+            {names.map((name) => (
+              <li key={name}>{name}</li>
+            ))}
+          </ul>
+        );
+      }}
+    </AsyncContent>
+  );
+}
