+export function PortfolioHealth({ positions }: { positions: Position[] }) {
+  const { score } = healthScore(positions);
+  return (
+    <div className="health">
+      <p className="health__label">Health score: {score} / 100</p>
+      <svg className="health__chart" width="100%" height="12">
+        <rect className="health__track" x="0" y="0" width="100%" height="12" rx="6" />
+        <rect
+          className="health__bar"
+          role="progressbar"
+          aria-label="Health score"
+          aria-valuemin={0}
+          aria-valuemax={100}
+          aria-valuenow={score}
+          x="0"
+          y="0"
+          width={`${score}%`}
+          height="12"
+          rx="6"
+        />
+      </svg>
+    </div>
+  );
+}
