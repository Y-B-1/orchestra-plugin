--- /dev/null
+++ b/src/utils/clients.ts
@@ -0,0 +1,45 @@
+import type { Client, Trade } from "../types";
+
+/** One client can hold several accounts (a closed one and its replacement); the name is the identity. */
+export function clientKey(name: string): string {
+  return name.trim().toLowerCase();
+}
+
+export interface ClientTotals {
+  name: string;
+  trades: number;
+  /** Assets under management across the client's open accounts. */
+  aumUsd: number;
+}
+
+/** One row per client: trades and open-account AUM summed over all of its accounts. */
+export function totalsByClient(clients: readonly Client[], trades: readonly Trade[]): ClientTotals[] {
+  const idToKey = new Map(clients.map((client) => [client.id, clientKey(client.name)]));
+  const rows = new Map<string, ClientTotals>();
+  for (const client of clients) {
+    const key = clientKey(client.name);
+    const row = rows.get(key) ?? { name: client.name, trades: 0, aumUsd: 0 };
+    if (client.status === "active") row.aumUsd += client.aum;
+    rows.set(key, row);
+  }
+  for (const trade of trades) {
+    const row = rows.get(idToKey.get(trade.clientId) ?? "");
+    if (row) row.trades += 1;
+  }
+  return [...rows.values()].sort((a, b) => b.trades - a.trades || a.name.localeCompare(b.name, "en-US"));
+}
+
+/** Clients whose first account was opened in the same month as `today`; a replacement account does not make a client new. */
+export function newClientsInMonth(clients: readonly Client[], today: string): string[] {
+  const month = today.slice(0, 7);
+  const firstOpened = new Map<string, { name: string; openedAt: string }>();
+  for (const client of clients) {
+    const key = clientKey(client.name);
+    const known = firstOpened.get(key);
+    if (!known || client.openedAt < known.openedAt) firstOpened.set(key, { name: client.name, openedAt: client.openedAt });
+  }
+  return [...firstOpened.values()]
+    .filter((entry) => entry.openedAt.slice(0, 7) === month)
+    .map((entry) => entry.name)
+    .sort((a, b) => a.localeCompare(b, "en-US"));
+}
