@@ -0,0 +1,13 @@
+import type { PricePoint } from "../types";
+
+/** The most days the daily trend ever shows. */
+export const TREND_MAX_DAYS = 30;
+
+/**
+ * The days of `points` (oldest first) between `from` and `to`, both days included and either one optional,
+ * cut to the latest `TREND_MAX_DAYS`.
+ */
+export function trendWindow(points: readonly PricePoint[], from: string, to: string): PricePoint[] {
+  const inRange = points.filter((point) => (!from || point.date >= from) && (!to || point.date <= to));
+  return inRange.slice(-TREND_MAX_DAYS);
+}
