diff --git a/src/components/portfolio/portfolioCsv.ts b/src/components/portfolio/portfolioCsv.ts
new file mode 100644
index 0000000..ba5685d
--- /dev/null
+++ b/src/components/portfolio/portfolioCsv.ts
@@ -0,0 +1,19 @@
+import type { Position } from "../../types";
+import { toCsv, type CsvColumn } from "../../utils/csv";
+import { formatPercent, formatWholeDollars } from "../../utils/format";
+import { formatSignedCurrency } from "../../utils/numbers";
+import { sortBy } from "../../utils/sort";
+
+const columns: CsvColumn<Position>[] = [
+  { header: "Instrument", value: (p) => p.symbol },
+  { header: "Name", value: (p) => p.name },
+  { header: "Book", value: (p) => p.book },
+  { header: "Market value (USD)", value: (p) => formatWholeDollars(p.marketValueUsd) },
+  { header: "Unrealized P&L (USD)", value: (p) => formatSignedCurrency(p.unrealizedPnlUsd) },
+  { header: "Weight", value: (p) => formatPercent(p.weight, 1) },
+];
+
+/** The holdings as CSV text, largest market value first, money written as it appears on screen. */
+export function holdingsCsv(positions: readonly Position[]): string {
+  return toCsv(sortBy(positions, (p) => p.marketValueUsd, "desc"), columns);
+}
