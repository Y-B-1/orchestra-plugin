+
+export interface HealthScore {
+  diversification: number;
+  performance: number;
+  /** The two parts added up, before it is held to 0..100. */
+  raw: number;
+  score: number;
+}
+
+/**
+ * Portfolio health from 0 to 100: up to 60 points for spreading risk (one minus the biggest position's
+ * weight) plus 200 times the unrealized return on cost. Each part is rounded to a whole number first, then
+ * the sum is held to 0..100, so the label and the bar always agree.
+ */
+export function healthScore(positions: readonly Position[]): HealthScore {
+  const totals = portfolioTotals(positions);
+  const largest = Math.max(0, ...positions.map((p) => p.weight));
+  const diversification = Math.round(60 * (1 - largest));
+  const performance = Math.round(200 * totals.unrealizedPnlPct);
+  const raw = diversification + performance;
+  return { diversification, performance, raw, score: clamp(raw, 0, 100) };
+}
+
+/** Positions by unrealized P&L in whole dollars, biggest first; equal amounts are ordered by name. */
+export function topContributors(positions: readonly Position[], limit = 10): Position[] {
+  return [...positions]
+    .sort(
+      (a, b) =>
+        Math.round(b.unrealizedPnlUsd) - Math.round(a.unrealizedPnlUsd) || a.name.localeCompare(b.name, "en-US"),
+    )
+    .slice(0, limit);
+}
