+++ b/src/components/dashboard/TradesByClient.tsx
@@ -0,0 +1,29 @@
+import { fetchClients, fetchTrades } from "../../api";
+import { useAsync } from "../../hooks/useAsync";
+import { totalsByClient } from "../../utils/clients";
+import { formatWholeDollars } from "../../utils/format";
+import { AsyncContent } from "../AsyncContent";
+
+async function load() {
+  const [clients, trades] = await Promise.all([fetchClients(), fetchTrades()]);
+  return totalsByClient(clients, trades);
+}
+
+export function TradesByClient() {
+  const state = useAsync(load, []);
+  return (
+    <AsyncContent state={state} loadingLabel="Loading trades by client">
+      {(rows) => (
+        <ul className="simple-list">
+          {rows.map((row) => (
+            <li key={row.name} className="simple-list__row">
+              <span className="simple-list__name">{row.name}</span>
+              <span>{row.trades} trades</span>
+              <span className="simple-list__aum">{formatWholeDollars(row.aumUsd)}</span>
+            </li>
+          ))}
+        </ul>
+      )}
+    </AsyncContent>
+  );
+}
diff --git a/src/components/instrument/DailyTrend.tsx b/src/components/instrument/DailyTrend.tsx
new file mode 100644
index 0000000..794966b
--- /dev/null
+++ b/src/components/instrument/DailyTrend.tsx
@@ -0,0 +1,44 @@
+import { useState } from "react";
+import { fetchDailyCloses } from "../../api";
+import { useAsync } from "../../hooks/useAsync";
+import { formatDate } from "../../utils/format";
+import { formatPrice } from "../../utils/numbers";
+import { trendWindow } from "../../utils/trend";
+import { AsyncContent } from "../AsyncContent";
+import { Table, type Column } from "../Table";
+import type { PricePoint } from "../../types";
+
+export function DailyTrend({ symbol, currency }: { symbol: string; currency: string }) {
+  const [from, setFrom] = useState("");
+  const [to, setTo] = useState("");
+  const state = useAsync(() => fetchDailyCloses(symbol), [symbol]);
+  const columns: Column<PricePoint>[] = [
+    { key: "date", header: "Date", rowHeader: true, render: (p) => formatDate(p.date) },
+    { key: "close", header: "Close", align: "right", render: (p) => formatPrice(p.close, currency) },
+  ];
+  return (
+    <>
+      <div className="filters">
+        <label className="filters__field">
+          From
+          <input type="date" className="input" value={from} onChange={(event) => setFrom(event.target.value)} />
+        </label>
+        <label className="filters__field">
+          To
+          <input type="date" className="input" value={to} onChange={(event) => setTo(event.target.value)} />
+        </label>
+      </div>
+      <AsyncContent state={state} loadingLabel="Loading daily trend">
+        {(points) => (
+          <Table
+            caption="Daily trend"
+            columns={columns}
+            rows={trendWindow(points, from, to)}
+            rowKey={(p) => p.date}
+            emptyMessage="No daily data in this range."
+          />
+        )}
+      </AsyncContent>
+    </>
+  );
+}
