+import { formatWholeDollars } from "../utils/format";
+import { portfolioTotals } from "../utils/portfolio";
+
+/** A plain statement of the holdings for printing, outside the app shell. */
+export function PortfolioPrint() {
+  useDocumentTitle("Portfolio statement");
+  const state = useAsync(fetchPositions, []);
+  return (
+    <main className="print-view">
+      <h1>Portfolio statement</h1>
+      <p className="print-view__back">
+        <Link to="/portfolio">Back to portfolio</Link>
+      </p>
