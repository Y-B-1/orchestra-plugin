   return delay(points.slice(-count).map((point) => ({ ...point })));
 }
+
+/** Every daily close we hold for `symbol` (about 90 trading days), oldest first. */
+export async function fetchDailyCloses(symbol: string): Promise<PricePoint[]> {
+  const points = history[symbol];
+  if (!points) throw new NotFoundError("Price history for", symbol);
+  return delay(points.map((point) => ({ ...point })));
+}
