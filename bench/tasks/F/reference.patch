+          <table className="table">
+            <thead>
+              <tr>
+                <th scope="col">Instrument</th>
+                <th scope="col" className="table__num">
+                  Market value (USD)
+                </th>
+              </tr>
+            </thead>
+            <tbody>
+              {[...positions]
