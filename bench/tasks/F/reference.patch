+import { describe, expect, it } from "vitest";
+import type { Client, Trade } from "../types";
+import { newClientsInMonth, totalsByClient } from "./clients";
+
+const client = (id: string, name: string, status: Client["status"], openedAt: string, aum: number) =>
+  ({ id, name, status, openedAt, aum }) as Client;
+const trade = (clientId: string) => ({ clientId }) as Trade;
+
+const clients = [
+  client("1", "Quill Software", "closed", "2025-11-03", 38),
+  client("2", "quill software ", "active", "2026-10-15", 41),
+  client("3", "Tidewater", "active", "2026-10-08", 67),
+  client("4", "Aardvark", "active", "2025-01-01", 5),
+];
+
+describe("totalsByClient", () => {
+  it("sums trades over every account of a client, counts only open accounts' AUM and orders ties by name", () => {
+    const rows = totalsByClient(clients, [trade("1"), trade("1"), trade("2"), trade("3"), trade("4")]);
+    expect(rows).toEqual([
+      { name: "Quill Software", trades: 3, aumUsd: 41 },
+      { name: "Aardvark", trades: 1, aumUsd: 5 },
+      { name: "Tidewater", trades: 1, aumUsd: 67 },
+    ]);
+  });
+});
+
+describe("newClientsInMonth", () => {
+  it("does not treat a replacement account as a new client", () => {
+    expect(newClientsInMonth(clients, "2026-10-27")).toEqual(["Tidewater"]);
+    expect(newClientsInMonth(clients, "2026-11-02")).toEqual([]);
+  });
+});
