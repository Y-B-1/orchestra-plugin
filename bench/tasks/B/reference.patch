new file mode 100644
index 0000000..b07037e
--- /dev/null
+++ b/src/components/portfolio/Rebalance.tsx
@@ -0,0 +1,79 @@
+import { useId, useState } from "react";
+import type { AllocationSlice, AssetClass } from "../../types";
+import { assetClassLabels } from "../../utils/portfolio";
+import { defaultTargets, REBALANCE_CLASSES, rebalanceTrades, targetTotal, type Targets } from "../../utils/rebalance";
+
+const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
+
+function tradeLabel(tradeUsd: number): string {
+  const rounded = Math.round(tradeUsd);
+  if (rounded === 0) return "No change";
+  return `${rounded > 0 ? "Buy" : "Sell"} ${usd.format(Math.abs(rounded))}`;
+}
+
+/** Target weights per asset class and the trades that would reach them. */
+export function Rebalance({ slices }: { slices: readonly AllocationSlice[] }) {
+  const id = useId();
+  const [targets, setTargets] = useState<Targets>(() => defaultTargets(slices));
+  const total = targetTotal(targets);
+
+  function setTarget(assetClass: AssetClass, value: string) {
+    const next = Number(value);
+    setTargets((prev) => ({ ...prev, [assetClass]: Number.isFinite(next) ? next : 0 }));
+  }
+
+  return (
+    <div className="rebalance">
+      <div className="rebalance__inputs">
+        {REBALANCE_CLASSES.map((assetClass) => (
+          <div key={assetClass} className="filters__field">
+            <label className="filters__label" htmlFor={`${id}-${assetClass}`}>
+              {assetClassLabels[assetClass]} target %
+            </label>
+            <input
+              id={`${id}-${assetClass}`}
+              type="number"
+              min={0}
+              max={100}
+              className="input input--compact"
+              value={targets[assetClass]}
+              onChange={(event) => setTarget(assetClass, event.target.value)}
+            />
+          </div>
+        ))}
+        <button type="button" className="button button--ghost" onClick={() => setTargets(defaultTargets(slices))}>
+          Reset to current
+        </button>
+      </div>
+      {total !== 100 ? (
+        <p className="filters__error" role="alert">
+          Targets must add up to 100% (now {total}%)
+        </p>
+      ) : (
+        <div className="table-wrap">
+          <table className="table">
+            <caption className="visually-hidden">Rebalancing trades</caption>
+            <thead>
+              <tr>
+                <th scope="col">Asset class</th>
+                <th scope="col" className="table__num">Current value</th>
+                <th scope="col" className="table__num">Target value</th>
+                <th scope="col" className="table__num">Trade</th>
+              </tr>
+            </thead>
+            <tbody>
+              {rebalanceTrades(slices, targets).map((row) => (
+                <tr key={row.assetClass}>
+                  <th scope="row">{assetClassLabels[row.assetClass]}</th>
+                  <td className="table__num">{usd.format(Math.round(row.currentUsd))}</td>
+                  <td className="table__num">{usd.format(Math.round(row.targetUsd))}</td>
+                  <td className="table__num">{tradeLabel(row.tradeUsd)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </div>
+  );
+}
