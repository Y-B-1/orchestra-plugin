+/** Every page in the sidebar, in order. The one place that names a route. */
+export const pages = [
+  { path: "/", label: "Dashboard", end: true },
+  { path: "/portfolio", label: "Portfolio", end: false },
+  { path: "/trades", label: "Trades", end: false },
+  { path: "/clients", label: "Clients", end: false },
+  { path: "/reports", label: "Reports", end: false },
+  { path: "/settings", label: "Settings", end: false },
+] as const;
+
+/** The name shown in the top bar and the browser tab for a path. */
+export function routeTitle(pathname: string): string {
+  const instrument = /^\/instruments\/([^/]+)/.exec(pathname);
+  if (instrument?.[1]) return decodeURIComponent(instrument[1]).toUpperCase();
+  if (pathname.startsWith("/clients/")) return "Clients";
+  return pages.find((page) => page.path === pathname)?.label ?? "Pulse";
+}
