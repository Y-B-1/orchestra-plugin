--- /dev/null
+++ b/src/utils/rebalance.ts
@@ -0,0 +1,37 @@
+import type { AllocationSlice, AssetClass } from "../types";
+
+export const REBALANCE_CLASSES: AssetClass[] = ["equity", "bond", "commodity", "fx"];
+
+export type Targets = Record<AssetClass, number>;
+
+/** Current weights as whole percents; any rounding gap goes to the largest class so they total 100. */
+export function defaultTargets(slices: readonly AllocationSlice[]): Targets {
+  const targets: Targets = { equity: 0, bond: 0, commodity: 0, fx: 0 };
+  for (const slice of slices) targets[slice.assetClass] = Math.round(slice.weight * 100);
+  const gap = 100 - REBALANCE_CLASSES.reduce((sum, key) => sum + targets[key], 0);
+  const largest = [...slices].sort((a, b) => b.valueUsd - a.valueUsd)[0];
+  if (gap !== 0 && largest) targets[largest.assetClass] += gap;
+  return targets;
+}
+
+export function targetTotal(targets: Targets): number {
+  return REBALANCE_CLASSES.reduce((sum, key) => sum + targets[key], 0);
+}
+
+export interface RebalanceRow {
+  assetClass: AssetClass;
+  currentUsd: number;
+  targetUsd: number;
+  /** Positive to buy, negative to sell. */
+  tradeUsd: number;
+}
+
+/** What to buy or sell per asset class to move the book to `targets` (percent of today's value). */
+export function rebalanceTrades(slices: readonly AllocationSlice[], targets: Targets): RebalanceRow[] {
+  const total = slices.reduce((sum, slice) => sum + slice.valueUsd, 0);
+  return REBALANCE_CLASSES.map((assetClass) => {
+    const currentUsd = slices.find((slice) => slice.assetClass === assetClass)?.valueUsd ?? 0;
+    const targetUsd = (total * targets[assetClass]) / 100;
+    return { assetClass, currentUsd, targetUsd, tradeUsd: targetUsd - currentUsd };
+  });
+}
