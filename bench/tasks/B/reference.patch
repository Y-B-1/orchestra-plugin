+import { useState } from "react";
+import { Link, useParams } from "react-router-dom";
+import { fetchClient, fetchClientTrades } from "../api";
+import { AsyncContent } from "../components/AsyncContent";
+import { ClientNotes } from "../components/clients/ClientNotes";
+import { Pagination } from "../components/Pagination";
+import { StatList } from "../components/StatList";
+import { Table } from "../components/Table";
+import { TradeDetail } from "../components/trades/TradeDetail";
+import { clientTradeColumns } from "../components/trades/tradeColumns";
+import { useAsync } from "../hooks/useAsync";
+import type { Client, Trade } from "../types";
+import { clientMeta } from "../utils/clients";
+import { formatCompactCurrency, formatDateTime, formatNumber } from "../utils/format";
+import { DEFAULT_PAGE_SIZE, paginate } from "../utils/pagination";
+
+interface ClientBundle {
+  client: Client;
+  trades: Trade[];
+}
+
+async function loadClient(id: string): Promise<ClientBundle> {
+  const [client, trades] = await Promise.all([fetchClient(id), fetchClientTrades(id)]);
+  return { client, trades };
+}
+
+function ClientTrades({ client, trades }: ClientBundle) {
+  const [page, setPage] = useState(1);
+  const [openId, setOpenId] = useState<string | null>(null);
+  return (
+    <>
+      <Table
+        caption={`Trades for ${client.name}`}
+        columns={clientTradeColumns}
+        rows={paginate(trades, page, DEFAULT_PAGE_SIZE)}
+        rowKey={(trade) => trade.id}
+        emptyMessage="This client has no trades."
+        onRowClick={(trade) => setOpenId(trade.id)}
+        rowLabel={(trade) => `Trade ${trade.id}`}
+        selectedKey={openId}
+      />
+      <Pagination total={trades.length} page={page} pageSize={DEFAULT_PAGE_SIZE} onPageChange={setPage} noun="trades" />
+      {openId ? <TradeDetail tradeId={openId} onClose={() => setOpenId(null)} /> : null}
+    </>
+  );
+}
+
+function ClientView({ client, trades }: ClientBundle) {
+  return (
+    <>
+      <section className="panel" aria-label="Client">
+        <h2 className="client-page__name">{client.name}</h2>
+        <p className="client-page__meta">{clientMeta(client)}</p>
+        <StatList
+          columns={4}
+          stats={[
+            { label: "Assets under management", value: formatCompactCurrency(client.aum, "USD", 2) },
+            { label: "Contact", value: <a href={`mailto:${client.email}`}>{client.contact}</a> },
+            { label: "Trades", value: formatNumber(trades.length) },
+            { label: "Last activity", value: `${formatDateTime(client.lastActivity)} UTC` },
+          ]}
+        />
+      </section>
+      <section className="panel" aria-label="Trades">
+        <div className="panel__header">
+          <h2 className="panel__title">Trades</h2>
+        </div>
+        <ClientTrades client={client} trades={trades} />
+      </section>
+      <section className="panel" aria-label="Notes">
+        <div className="panel__header">
+          <h2 className="panel__title">Notes</h2>
+        </div>
+        <ClientNotes key={client.id} clientId={client.id} />
+      </section>
+    </>
+  );
+}
+
+/** A full page for one client: key facts, every trade and the notes. */
+export function ClientPage() {
+  const { id = "" } = useParams();
+  const state = useAsync(() => loadClient(id), [id]);
+  return (
+    <div className="page">
+      <nav className="breadcrumbs" aria-label="Breadcrumb">
+        <Link to="/clients">All clients</Link>
+      </nav>
+      <AsyncContent state={state} loadingLabel="Loading client">
+        {(bundle) => <ClientView client={bundle.client} trades={bundle.trades} />}
+      </AsyncContent>
+    </div>
+  );
+}
