+import type { PricePoint } from "../types";
+
+/** Change from the first to the last close, as a fraction; null without two points. */
+export function periodChange(points: readonly PricePoint[]): number | null {
+  const first = points[0];
+  const last = points[points.length - 1];
+  if (!first || !last || points.length < 2 || first.close === 0) return null;
+  return (last.close - first.close) / first.close;
+}
