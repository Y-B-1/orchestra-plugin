+  });
+});
diff --git a/src/components/search/searchResults.ts b/src/components/search/searchResults.ts
new file mode 100644
index 0000000..3db0bca
--- /dev/null
+++ b/src/components/search/searchResults.ts
@@ -0,0 +1,47 @@
+import type { Client, Instrument } from "../../types";
+import { matchesQuery } from "../../utils/search";
+
+export interface SearchHit {
+  id: string;
+  label: string;
+  to: string;
+}
+
+export interface SearchGroup {
+  title: "Instruments" | "Clients" | "Pages";
+  hits: SearchHit[];
+}
+
+export interface SearchSources {
+  instruments: readonly Instrument[];
+  clients: readonly Client[];
+  pages: readonly { label: string; to: string }[];
+}
+
+const PER_GROUP = 5;
+
+/** Matches grouped as Instruments, Clients, Pages; empty groups are left out. */
+export function searchAll(query: string, sources: SearchSources): SearchGroup[] {
+  if (query.trim() === "") return [];
+  const groups: SearchGroup[] = [
+    {
+      title: "Instruments",
+      hits: sources.instruments
+        .filter((i) => matchesQuery(query, i.symbol, i.name))
+        .map((i) => ({ id: `i-${i.symbol}`, label: `${i.symbol} ${i.name}`, to: `/instruments/${i.symbol}` })),
+    },
+    {
+      title: "Clients",
+      hits: sources.clients
+        .filter((c) => matchesQuery(query, c.name, c.contact))
+        .map((c) => ({ id: `c-${c.id}`, label: c.name, to: `/clients?client=${encodeURIComponent(c.id)}` })),
+    },
+    {
+      title: "Pages",
+      hits: sources.pages
+        .filter((p) => matchesQuery(query, p.label))
+        .map((p) => ({ id: `p-${p.to}`, label: p.label, to: p.to })),
+    },
+  ];
+  return groups.map((g) => ({ ...g, hits: g.hits.slice(0, PER_GROUP) })).filter((g) => g.hits.length > 0);
+}
