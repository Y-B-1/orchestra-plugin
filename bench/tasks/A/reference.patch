+import { describe, expect, it } from "vitest";
+import clients from "../../data/clients.json";
+import instruments from "../../data/instruments.json";
+import type { Client, Instrument } from "../../types";
+import { searchAll } from "./searchResults";
+
+const sources = {
+  instruments: instruments as Instrument[],
+  clients: clients as Client[],
+  pages: [
+    { label: "Portfolio", to: "/portfolio" },
+    { label: "Reports", to: "/reports" },
+  ],
+};
+
+describe("searchAll", () => {
+  it("groups matches by kind and skips empty groups", () => {
+    expect(searchAll("  ", sources)).toEqual([]);
+    expect(searchAll("port", sources).map((g) => [g.title, g.hits.map((h) => h.label)])).toEqual([
+      ["Pages", ["Portfolio", "Reports"]],
+    ]);
+    const [group] = searchAll("ines", sources);
+    expect(group).toMatchObject({ title: "Clients", hits: [{ label: "Northwind Capital", to: "/clients?client=c-001" }] });
