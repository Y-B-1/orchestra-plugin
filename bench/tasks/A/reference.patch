index 0000000..4667630
--- /dev/null
+++ b/src/components/search/GlobalSearch.tsx
@@ -0,0 +1,67 @@
+import { useMemo, useState, type KeyboardEvent } from "react";
+import { Link, useNavigate } from "react-router-dom";
+import { fetchClients, fetchInstruments } from "../../api";
+import { useAsync } from "../../hooks/useAsync";
+import { navLinks } from "../Sidebar";
+import { searchAll } from "./searchResults";
+
+async function loadSources() {
+  const [instruments, clients] = await Promise.all([fetchInstruments(), fetchClients()]);
+  return { instruments, clients, pages: navLinks };
+}
+
+/** Top bar search over instruments, clients and pages. Enter opens the first result, Escape closes. */
+export function GlobalSearch() {
+  const [query, setQuery] = useState("");
+  const navigate = useNavigate();
+  const sources = useAsync(loadSources, []);
+  const groups = useMemo(() => (sources.data ? searchAll(query, sources.data) : []), [query, sources.data]);
+  const open = query.trim() !== "";
+
+  function onKeyDown(event: KeyboardEvent<HTMLInputElement>) {
+    if (event.key === "Escape") {
+      setQuery("");
+    } else if (event.key === "Enter") {
+      const first = groups[0]?.hits[0];
+      if (first) {
+        event.preventDefault();
+        setQuery("");
+        navigate(first.to);
+      }
+    }
+  }
+
+  return (
+    <div className="search">
+      <input
+        type="search"
+        className="input search__input"
+        aria-label="Search Pulse"
+        placeholder="Search instruments, clients and pages"
+        value={query}
+        onChange={(event) => setQuery(event.target.value)}
+        onKeyDown={onKeyDown}
+      />
+      {open ? (
+        <div className="search__results" role="region" aria-label="Search results">
+          {sources.loading && !sources.data ? <p className="search__empty">Searching...</p> : null}
+          {sources.data && groups.length === 0 ? <p className="search__empty">No matches</p> : null}
+          {groups.map((group) => (
+            <div key={group.title} className="search__group">
+              <p className="search__group-title">{group.title}</p>
+              <ul className="search__list">
+                {group.hits.map((hit) => (
+                  <li key={hit.id}>
+                    <Link to={hit.to} className="search__hit" onClick={() => setQuery("")}>
+                      {hit.label}
+                    </Link>
+                  </li>
+                ))}
+              </ul>
+            </div>
+          ))}
+        </div>
+      ) : null}
+    </div>
+  );
+}
