+import { describe, expect, it } from "vitest";
+import { periodChange } from "./compare";
+
+describe("periodChange", () => {
+  it("measures first to last close and needs two points", () => {
+    expect(periodChange([{ date: "a", close: 100 }, { date: "b", close: 90 }, { date: "c", close: 125 }])).toBeCloseTo(0.25);
