+import type { ReactNode } from "react";
+import { useSearchParams } from "react-router-dom";
+import { fetchInstrument, fetchInstrumentStats, fetchInstruments, fetchPriceHistory } from "../api";
+import { AsyncContent } from "../components/AsyncContent";
+import { PriceChange } from "../components/PriceChange";
+import { useAsync } from "../hooks/useAsync";
+import { useDocumentTitle } from "../hooks/useDocumentTitle";
+import type { Instrument, InstrumentStats } from "../types";
+import { periodChange } from "../utils/compare";
+import { formatPrice } from "../utils/numbers";
+
+export const DEFAULT_PAIR = { a: "AAPL", b: "MSFT" };
+
+interface Side {
+  instrument: Instrument;
+  stats: InstrumentStats;
+  change3m: number | null;
+}
+
+async function loadSide(symbol: string): Promise<Side> {
+  const [instrument, stats, history] = await Promise.all([
+    fetchInstrument(symbol),
+    fetchInstrumentStats(symbol),
+    fetchPriceHistory(symbol, "3M"),
+  ]);
+  return { instrument, stats, change3m: periodChange(history) };
+}
+
+const rows: { label: string; value: (side: Side) => ReactNode }[] = [
+  { label: "Last price", value: (s) => formatPrice(s.instrument.price, s.instrument.currency) },
+  { label: "Day change", value: (s) => <PriceChange pct={s.instrument.changePct} /> },
+  { label: "3 month change", value: (s) => (s.change3m === null ? "n/a" : <PriceChange pct={s.change3m} />) },
+  { label: "3 month high", value: (s) => formatPrice(s.stats.rangeHigh, s.instrument.currency) },
+  { label: "3 month low", value: (s) => formatPrice(s.stats.rangeLow, s.instrument.currency) },
+  { label: "Exchange", value: (s) => s.stats.exchange },
+  { label: "Sector", value: (s) => s.stats.sector },
+];
+
+function ComparisonTable({ left, right }: { left: Side; right: Side }) {
+  return (
+    <div className="table-wrap">
+      <table className="table compare-table">
+        <caption className="visually-hidden">Comparison</caption>
+        <thead>
+          <tr>
+            <th scope="col">Measure</th>
+            <th scope="col" className="table__num">{left.instrument.symbol}</th>
+            <th scope="col" className="table__num">{right.instrument.symbol}</th>
+          </tr>
+        </thead>
+        <tbody>
+          {rows.map((row) => (
+            <tr key={row.label}>
+              <th scope="row">{row.label}</th>
+              <td className="table__num">{row.value(left)}</td>
+              <td className="table__num">{row.value(right)}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
+
+function Pair({ a, b }: { a: string; b: string }) {
+  const state = useAsync(() => Promise.all([loadSide(a), loadSide(b)]), [a, b]);
+  return (
+    <AsyncContent state={state} loadingLabel="Loading comparison">
+      {([left, right]) => <ComparisonTable left={left} right={right} />}
+    </AsyncContent>
+  );
+}
+
+export function Compare() {
+  useDocumentTitle("Compare");
+  const [params, setParams] = useSearchParams();
+  const a = (params.get("a") ?? DEFAULT_PAIR.a).toUpperCase();
+  const b = (params.get("b") ?? DEFAULT_PAIR.b).toUpperCase();
+  const instruments = useAsync(() => fetchInstruments(), []);
+
+  function choose(key: "a" | "b", symbol: string) {
+    const next = { a, b, [key]: symbol };
+    setParams({ a: next.a, b: next.b }, { replace: true });
+  }
+
+  return (
+    <div className="page">
+      <section className="panel" aria-label="Compare instruments">
+        <div className="panel__header">
+          <h2 className="panel__title">
+            {a} vs {b}
+          </h2>
+        </div>
+        <AsyncContent state={instruments} loadingLabel="Loading instruments">
+          {(list) => (
+            <div className="compare__pickers">
+              {(["a", "b"] as const).map((key) => (
+                <label key={key} className="filters__field">
+                  <span className="filters__label">{key === "a" ? "First instrument" : "Second instrument"}</span>
+                  <select className="input" value={key === "a" ? a : b} onChange={(event) => choose(key, event.target.value)}>
+                    {list.map((instrument) => (
+                      <option key={instrument.symbol} value={instrument.symbol}>
+                        {instrument.symbol} {instrument.name}
+                      </option>
+                    ))}
+                  </select>
+                </label>
+              ))}
+            </div>
+          )}
+        </AsyncContent>
+        {a === b ? <p className="feedback feedback--empty">Pick two different instruments.</p> : <Pair a={a} b={b} />}
+      </section>
+    </div>
+  );
+}
