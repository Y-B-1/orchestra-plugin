+import { describe, expect, it } from "vitest";
+import type { Trade } from "../types";
+import { summarizeDay } from "./tradeDay";
+
+const trade = (executedAt: string, status: Trade["status"] = "filled") => ({ executedAt, status }) as Trade;
+
+describe("summarizeDay", () => {
+  const trades = [trade("2026-10-27T23:59:00Z", "pending"), trade("2026-10-28T00:01:00Z"), trade("2026-10-27T00:00:00Z", "partial")];
+
+  it("counts by the UTC day, so trades either side of midnight land on different days", () => {
+    const late = summarizeDay(trades, new Date("2026-10-27T23:59:30Z"));
+    expect(late).toMatchObject({ day: "2026-10-27", trades: 2 });
+    expect(late.byStatus).toEqual({ filled: 0, partial: 1, cancelled: 0, pending: 1 });
+    const early = summarizeDay(trades, new Date("2026-10-28T00:01:30Z"));
+    expect(early).toMatchObject({ day: "2026-10-28", trades: 1 });
+    expect(early.byStatus.filled).toBe(1);
+  });
+});
