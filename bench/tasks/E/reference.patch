+function nextTradeId(): string {
+  const highest = Math.max(0, ...trades.map((trade) => Number(trade.id.slice(2)) || 0));
+  return `T-${highest + 1}`;
+}
+
+/** Books a new order. It starts as pending, with nothing filled yet. */
+export async function bookTrade(ticket: TradeTicket, now: Date = new Date()): Promise<Trade> {
+  const instrument = instruments.find((i) => i.symbol === ticket.symbol);
+  if (!instrument) throw new NotFoundError("Instrument", ticket.symbol);
+  if (!Number.isInteger(ticket.quantity) || ticket.quantity <= 0) throw new ValidationError("Enter a quantity above zero");
+  if (!(ticket.price > 0)) throw new ValidationError("Enter a price above zero");
+  const trade: Trade = {
+    id: nextTradeId(),
+    symbol: instrument.symbol,
+    assetClass: instrument.assetClass,
+    side: ticket.side,
+    quantity: ticket.quantity,
+    filledQuantity: 0,
+    price: ticket.price,
+    currency: instrument.currency,
+    executedAt: now.toISOString(),
+    clientId: ticket.clientId,
+    trader: BOOKING_TRADER,
+    venue: BOOKING_VENUE,
+    status: "pending",
+    fees: 0,
+  };
+  trades.push(trade);
+  return delay({ ...trade });
+}
+
+/** Cancels a pending order; anything already (partly) filled cannot be cancelled here. */
+export async function cancelTrade(id: string): Promise<Trade> {
+  const found = trades.find((t) => t.id === id);
+  if (!found) throw new NotFoundError("Trade", id);
+  if (found.status !== "pending") throw new ValidationError(`Trade ${id} is not pending`);
+  found.status = "cancelled";
+  return delay({ ...found });
+}
+
+/** The full order size in USD, at the order price. */
+export function orderValueUsd(trade: Pick<Trade, "quantity" | "price" | "currency">): number {
+  return toUsd(trade.quantity * trade.price, trade.currency, rates);
+}
