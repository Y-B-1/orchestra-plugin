+          {lists.clients.map((client) => (
+            <option key={client.id} value={client.id}>
+              {client.name}
+            </option>
+          ))}
+        </select>
+      </div>
+      <div className="ticket__field">
+        <label htmlFor={`${id}-symbol`}>Instrument</label>
+        <select id={`${id}-symbol`} className="input" value={symbol} onChange={(event) => changeInstrument(event.target.value)}>
+          {lists.instruments.map((instrument) => (
+            <option key={instrument.symbol} value={instrument.symbol}>
+              {instrument.symbol} {instrument.name}
+            </option>
+          ))}
+        </select>
+      </div>
+      <div className="ticket__field">
+        <label htmlFor={`${id}-side`}>Side</label>
+        <select id={`${id}-side`} className="input" value={side} onChange={(event) => setSide(event.target.value as TradeSide)}>
+          <option value="buy">Buy</option>
+          <option value="sell">Sell</option>
+        </select>
+      </div>
+      <div className="ticket__field">
+        <label htmlFor={`${id}-quantity`}>Quantity</label>
+        <input
+          id={`${id}-quantity`}
+          className="input"
+          type="number"
+          min={1}
+          step={1}
+          value={quantity}
+          aria-invalid={shown.quantity ? true : undefined}
+          aria-describedby={shown.quantity ? `${id}-quantity-error` : undefined}
+          onChange={(event) => setQuantity(event.target.value)}
+        />
+        {shown.quantity ? (
+          <p id={`${id}-quantity-error`} className="ticket__error" role="alert">
+            {shown.quantity}
+          </p>
+        ) : null}
+      </div>
+      <div className="ticket__field">
+        <label htmlFor={`${id}-price`}>Price</label>
+        <input
+          id={`${id}-price`}
+          className="input"
+          type="number"
+          min={0}
+          step="any"
+          value={price}
+          aria-invalid={shown.price ? true : undefined}
+          aria-describedby={shown.price ? `${id}-price-error` : undefined}
+          onChange={(event) => setPrice(event.target.value)}
+        />
+        {shown.price ? (
+          <p id={`${id}-price-error`} className="ticket__error" role="alert">
+            {shown.price}
+          </p>
+        ) : null}
+      </div>
+      {failure ? <ErrorState error={failure} /> : null}
+      <div className="ticket__actions">
+        <button type="button" className="button button--ghost" onClick={onClose}>
+          Cancel
+        </button>
+        <button type="submit" className="button button--primary" disabled={busy}>
+          Book
+        </button>
+      </div>
+    </form>
+  );
+}
+
+export function BookTradeDialog({ onClose, onBooked }: BookTradeDialogProps) {
+  const lists = useAsync(loadLists, []);
+  return (
+    <Dialog title="Book trade" onClose={onClose}>
+      <AsyncContent state={lists} loadingLabel="Loading ticket">
+        {(data) => <Ticket lists={data} onClose={onClose} onBooked={onBooked} />}
+      </AsyncContent>
+    </Dialog>
+  );
+}
