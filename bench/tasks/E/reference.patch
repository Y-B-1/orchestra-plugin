@@ -0,0 +1,15 @@
+import type { TradeStatus } from "../types";
+
+/** Every trade status in display order, with the words the badge, filters, summaries and exports use. */
+export const tradeStatuses: readonly { value: TradeStatus; label: string }[] = [
+  { value: "filled", label: "Filled" },
+  { value: "partial", label: "Partially filled" },
+  { value: "cancelled", label: "Cancelled" },
+  { value: "pending", label: "Pending" },
+];
+
+const labels = new Map(tradeStatuses.map((status) => [status.value, status.label]));
+
+export function tradeStatusLabel(status: TradeStatus): string {
+  return labels.get(status) ?? status;
+}
