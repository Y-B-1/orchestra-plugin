+import { describe, expect, it } from "vitest";
+import type { Trade } from "../types";
+import { exposureBySymbol } from "./exposure";
+
+const trade = (symbol: string, side: Trade["side"], filledQuantity: number, status: Trade["status"] = "filled") =>
+  ({ symbol, side, filledQuantity, status }) as Trade;
+
+describe("exposureBySymbol", () => {
+  it("nets filled quantities per instrument and counts every order", () => {
+    const rows = exposureBySymbol([
+      trade("MSFT", "buy", 100),
+      trade("AAPL", "sell", 40),
+      trade("AAPL", "buy", 100),
+      trade("AAPL", "buy", 0, "pending"),
+    ]);
+    expect(rows).toEqual([
+      { symbol: "AAPL", bought: 100, sold: 40, net: 60, trades: 3 },
+      { symbol: "MSFT", bought: 100, sold: 0, net: 100, trades: 1 },
+    ]);
+  });
+});
diff --git a/src/utils/exposure.ts b/src/utils/exposure.ts
new file mode 100644
index 0000000..6ca0e40
--- /dev/null
+++ b/src/utils/exposure.ts
@@ -0,0 +1,26 @@
+import type { Trade } from "../types";
+
+export interface ExposureRow {
+  symbol: string;
+  bought: number;
+  sold: number;
+  net: number;
+  trades: number;
+}
+
+/**
+ * One row per instrument, A to Z. Bought and sold add up filled quantities, so pending and
+ * cancelled orders move nothing; the trade count includes every order whatever its status.
+ */
+export function exposureBySymbol(trades: readonly Trade[]): ExposureRow[] {
+  const rows = new Map<string, ExposureRow>();
+  for (const trade of trades) {
+    const row = rows.get(trade.symbol) ?? { symbol: trade.symbol, bought: 0, sold: 0, net: 0, trades: 0 };
+    if (trade.side === "buy") row.bought += trade.filledQuantity;
+    else row.sold += trade.filledQuantity;
+    row.net = row.bought - row.sold;
+    row.trades += 1;
+    rows.set(trade.symbol, row);
+  }
+  return [...rows.values()].sort((a, b) => a.symbol.localeCompare(b.symbol));
+}
