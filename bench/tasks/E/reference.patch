diff --git a/src/pages/Exposure.tsx b/src/pages/Exposure.tsx
new file mode 100644
index 0000000..113b769
--- /dev/null
+++ b/src/pages/Exposure.tsx
@@ -0,0 +1,101 @@
+import { useId, useRef } from "react";
+import { useSearchParams } from "react-router-dom";
+import { fetchClient, fetchClients, fetchClientTrades } from "../api";
+import { AsyncContent } from "../components/AsyncContent";
+import { Table, type Column } from "../components/Table";
+import { useAsync } from "../hooks/useAsync";
+import { useDocumentTitle } from "../hooks/useDocumentTitle";
+import type { Client, Trade } from "../types";
+import { exposureBySymbol, type ExposureRow } from "../utils/exposure";
+import { formatQuantity } from "../utils/numbers";
+
+const columns: Column<ExposureRow>[] = [
+  { key: "symbol", header: "Instrument", rowHeader: true, render: (row) => row.symbol },
+  { key: "bought", header: "Bought", align: "right", render: (row) => formatQuantity(row.bought) },
+  { key: "sold", header: "Sold", align: "right", render: (row) => formatQuantity(row.sold) },
+  { key: "net", header: "Net", align: "right", render: (row) => formatQuantity(row.net) },
+  { key: "trades", header: "Trades", align: "right", render: (row) => formatQuantity(row.trades) },
+];
+
+interface ClientExposure {
+  client: Client;
+  rows: ExposureRow[];
+}
+
+async function loadClientList(): Promise<Client[]> {
+  return [...(await fetchClients())].sort((a, b) => a.name.localeCompare(b.name));
+}
+
+function ExposureView({ clientId }: { clientId: string }) {
+  // Trades already loaded on this visit, so flipping back to a client is instant. The cache
+  // lives with the page, not the module: leaving the page (for example to book a trade) drops it.
+  const cache = useRef(new Map<string, Trade[]>());
+  // The client and its rows load together, so a slow answer for an earlier pick can never
+  // show under the name of a later one; useAsync also drops answers for a superseded pick.
+  const state = useAsync(async (): Promise<ClientExposure> => {
+    const cached = cache.current.get(clientId);
+    const [client, trades] = await Promise.all([
+      fetchClient(clientId),
+      cached ? Promise.resolve(cached) : fetchClientTrades(clientId),
+    ]);
+    cache.current.set(clientId, trades);
+    return { client, rows: exposureBySymbol(trades) };
+  }, [clientId]);
+  return (
+    <AsyncContent state={state} loadingLabel="Loading exposure">
+      {({ client, rows }) => (
+        <>
+          <h3 className="panel__title">Exposure for {client.name}</h3>
+          <Table
+            caption="Exposure by instrument"
+            columns={columns}
+            rows={rows}
+            rowKey={(row) => row.symbol}
+            emptyMessage={`${client.name} has no trades.`}
+          />
+        </>
+      )}
+    </AsyncContent>
+  );
+}
+
+export function Exposure() {
+  useDocumentTitle("Exposure");
+  const id = useId();
+  const [params, setParams] = useSearchParams();
+  const clientId = params.get("client") ?? "";
+  const clients = useAsync(loadClientList, []);
+
+  return (
+    <div className="page">
+      <section className="panel" aria-label="Client exposure">
+        <div className="panel__header">
+          <h2 className="panel__title">Client exposure</h2>
+          <div className="filters__field">
+            <label className="filters__label" htmlFor={id}>
+              Client
+            </label>
+            <select
+              id={id}
+              className="input input--compact"
+              value={clientId}
+              onChange={(event) => setParams(event.target.value ? { client: event.target.value } : {})}
+            >
+              <option value="">Choose a client</option>
+              {(clients.data ?? []).map((client) => (
+                <option key={client.id} value={client.id}>
+                  {client.name}
+                </option>
+              ))}
+            </select>
+          </div>
+        </div>
+        {clientId ? (
+          <ExposureView clientId={clientId} />
+        ) : (
+          <p className="feedback feedback--empty">Pick a client to see their exposure.</p>
+        )}
+      </section>
+    </div>
+  );
+}
