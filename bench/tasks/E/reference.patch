+++ b/src/utils/largeTrade.ts
@@ -0,0 +1,16 @@
+import type { AppNotification, Trade } from "../types";
+import { formatQuantity } from "./numbers";
+
+/** The unread notification for a booked trade worth at least the alert threshold, or null below it. */
+export function largeTradeNotification(trade: Trade, valueUsd: number, thresholdUsd: number, clientName: string): AppNotification | null {
+  if (!(thresholdUsd > 0) || valueUsd < thresholdUsd) return null;
+  return {
+    id: `large-${trade.id}`,
+    kind: "trade",
+    title: `Large trade booked: ${trade.id}`,
+    body: `${trade.side === "buy" ? "Buy" : "Sell"} ${formatQuantity(trade.quantity)} ${trade.symbol} for ${clientName}`,
+    createdAt: trade.executedAt,
+    read: false,
+    link: `/trades?trade=${trade.id}`,
+  };
+}
