@@ -0,0 +1,68 @@
+import { useMemo } from "react";
+import type { SortState, Trade } from "../../types";
+import { formatNumber } from "../../utils/format";
+import { paginate } from "../../utils/pagination";
+import { Pagination } from "../Pagination";
+import { sortRows, Table } from "../Table";
+import { blotterColumns } from "./tradeColumns";
+
+export type PageSize = 25 | 50 | 100 | "all";
+
+export const pageSizes: readonly PageSize[] = [25, 50, 100, "all"];
+
+interface BlotterProps {
+  trades: Trade[];
+  sort: SortState | null;
+  onSortChange: (next: SortState) => void;
+  page: number;
+  onPageChange: (page: number) => void;
+  pageSize: PageSize;
+  onPageSizeChange: (size: PageSize) => void;
+  selectedId: string | null;
+  onSelect: (id: string) => void;
+}
+
+export function Blotter({ trades, sort, onSortChange, page, onPageChange, pageSize, onPageSizeChange, selectedId, onSelect }: BlotterProps) {
+  // Sorting is the only work proportional to the whole list; it runs once per data or sort change.
+  const sorted = useMemo(() => sortRows(trades, blotterColumns, sort), [trades, sort]);
+  const visible = pageSize === "all" ? sorted : paginate(sorted, page, pageSize);
+  return (
+    <>
+      <Table
+        caption="Trade blotter"
+        columns={blotterColumns}
+        rows={visible}
+        rowKey={(trade) => trade.id}
+        sort={sort}
+        onSortChange={onSortChange}
+        onRowClick={(trade) => onSelect(trade.id)}
+        rowLabel={(trade) => `Trade ${trade.id}`}
+        selectedKey={selectedId}
+        emptyMessage="No trades match these filters."
+      />
+      <div className="blotter-footer">
+        {pageSize === "all" ? (
+          <p className="pagination__summary" aria-live="polite">
+            Showing all {formatNumber(trades.length)} trades
+          </p>
+        ) : (
+          <Pagination total={trades.length} page={page} pageSize={pageSize} onPageChange={onPageChange} noun="trades" />
+        )}
+        <label className="blotter-footer__size">
+          Rows per page
+          <select
+            className="input input--compact"
+            value={String(pageSize)}
+            onChange={(event) => onPageSizeChange(event.target.value === "all" ? "all" : (Number(event.target.value) as PageSize))}
+          >
+            {pageSizes.map((size) => (
+              <option key={size} value={String(size)}>
+                {size === "all" ? "All" : size}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+    </>
+  );
+}
