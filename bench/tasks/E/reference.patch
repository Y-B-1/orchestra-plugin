+import { useId, useState, type FormEvent } from "react";
+import { bookTrade, fetchClients, fetchInstruments } from "../../api";
+import { toError, useAsync } from "../../hooks/useAsync";
+import type { Client, Instrument, Trade, TradeSide } from "../../types";
+import { AsyncContent } from "../AsyncContent";
+import { Dialog } from "../Dialog";
+import { ErrorState } from "../Feedback";
+
+interface BookTradeDialogProps {
+  onClose: () => void;
+  onBooked: (trade: Trade) => void;
+}
+
+interface Lists {
+  clients: Client[];
+  instruments: Instrument[];
+}
+
+async function loadLists(): Promise<Lists> {
+  const [clients, instruments] = await Promise.all([fetchClients(), fetchInstruments()]);
+  return { clients: [...clients].sort((a, b) => a.name.localeCompare(b.name)), instruments };
+}
+
+/** Checks the ticket and returns the problems to show, keyed by field. */
+export function ticketErrors(quantity: string, price: string): { quantity?: string; price?: string } {
+  const errors: { quantity?: string; price?: string } = {};
+  const qty = Number(quantity);
+  if (quantity.trim() === "" || !Number.isInteger(qty) || qty <= 0) errors.quantity = "Enter a quantity above zero";
+  if (price.trim() === "" || !(Number(price) > 0)) errors.price = "Enter a price above zero";
+  return errors;
+}
+
+function Ticket({ lists, onClose, onBooked }: BookTradeDialogProps & { lists: Lists }) {
+  const id = useId();
+  const [clientId, setClientId] = useState(lists.clients[0]?.id ?? "");
+  const [symbol, setSymbol] = useState(lists.instruments[0]?.symbol ?? "");
+  const [side, setSide] = useState<TradeSide>("buy");
+  const [quantity, setQuantity] = useState("");
+  const [price, setPrice] = useState(String(lists.instruments[0]?.price ?? ""));
+  const [shown, setShown] = useState<{ quantity?: string; price?: string }>({});
+  const [failure, setFailure] = useState<Error | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  function changeInstrument(next: string) {
+    setSymbol(next);
+    const instrument = lists.instruments.find((i) => i.symbol === next);
+    if (instrument) setPrice(String(instrument.price));
+  }
+
+  function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const errors = ticketErrors(quantity, price);
+    setShown(errors);
+    if (errors.quantity || errors.price) return;
+    setBusy(true);
+    bookTrade({ clientId, symbol, side, quantity: Number(quantity), price: Number(price) }).then(onBooked, (reason: unknown) => {
+      setFailure(toError(reason));
+      setBusy(false);
+    });
+  }
+
+  return (
+    <form className="ticket" onSubmit={submit} noValidate>
+      <div className="ticket__field">
+        <label htmlFor={`${id}-client`}>Client</label>
