new file mode 100644
index 0000000..468b7f3
--- /dev/null
+++ b/src/utils/tradeDay.ts
@@ -0,0 +1,26 @@
+import type { Trade, TradeStatus } from "../types";
+import { toIsoDay } from "./dates";
+import { tradeStatuses } from "./tradeStatus";
+
+export interface DaySummary {
+  day: string;
+  trades: number;
+  byStatus: Record<TradeStatus, number>;
+}
+
+/**
+ * Counts the trades executed on the UTC calendar day that contains `now`. The trading day
+ * runs from midnight to midnight UTC wherever the viewer is, so 23:59 UTC still counts
+ * for that day and 00:01 UTC belongs to the next one.
+ */
+export function summarizeDay(trades: readonly Trade[], now: Date): DaySummary {
+  const day = toIsoDay(now);
+  const byStatus = Object.fromEntries(tradeStatuses.map((status) => [status.value, 0])) as Record<TradeStatus, number>;
+  let count = 0;
+  for (const trade of trades) {
+    if (toIsoDay(new Date(trade.executedAt)) !== day) continue;
+    count += 1;
+    byStatus[trade.status] += 1;
+  }
+  return { day, trades: count, byStatus };
+}
